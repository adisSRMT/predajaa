rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dostop imajo samo prijavljeni uporabniki.
    function prijavljen() {
      return request.auth != null;
    }

    // Vozila: branje, dodajanje, spreminjanje. Brisanja ni.
    match /vozila/{id} {
      allow read, create, update: if prijavljen();
      allow delete: if false;
    }

    // Predaje: zapišejo se enkrat in se ne dajo več spremeniti ali izbrisati.
    match /predaje/{id} {
      allow read, create: if prijavljen();
      allow update, delete: if false;
    }

    // Podpisi: enako kot predaje.
    match /podpisi/{id} {
      allow read, create: if prijavljen();
      allow update, delete: if false;
    }

    // Napake: dodajanje in zapiranje. Brisanja ni.
    match /napake/{id} {
      allow read, create, update: if prijavljen();
      allow delete: if false;
    }
  }
}
