rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vsak prijavljen uporabnik.
    function prijavljen() {
      return request.auth != null;
    }

    // Skrbnik: e-poštni naslov je na seznamu spodaj (MALE ČRKE, več naslovov ločiš z vejico),
    // ALI pa ima v zbirki "uporabniki" dokument s svojim UID in poljem vloga = "admin".
    // Seznam uredi v Firebase konzoli, v zavihku Rules (glej BERI-ME.md, korak 6b).
    function jeAdmin() {
      return request.auth != null
        && (request.auth.token.email in ['adissaramati1@gmail.com']
            || (exists(/databases/$(database)/documents/uporabniki/$(request.auth.uid))
                && get(/databases/$(database)/documents/uporabniki/$(request.auth.uid)).data.vloga == 'admin'));
    }

    // Vloge: vsak lahko prebere samo svoj zapis, nihče ga ne more spremeniti iz aplikacije.
    match /uporabniki/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Vozila:
    //  - seznam vozil in posamezno vozilo lahko bere vsak prijavljen (izbira vozila, QR koda),
    //  - dodajanje vozil in spreminjanje njihovih podatkov (oznaka, skrivanje) samo skrbnik,
    //  - ob predaji lahko vsak prijavljen spremeni samo: zadnja, zadnje, zdravila, odprte.
    match /vozila/{id} {
      allow get, list: if prijavljen();
      allow create: if jeAdmin();
      allow update: if jeAdmin()
        || (prijavljen()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['zadnja', 'zadnje', 'zdravila', 'odprte']));
      allow delete: if false;
    }

    // Predaje: vsak prijavljen jih lahko odda, branje samo skrbnik.
    // Zapisane predaje se ne dajo spremeniti ali izbrisati.
    match /predaje/{id} {
      allow create: if prijavljen();
      allow read: if jeAdmin();
      allow update, delete: if false;
    }

    // Podpisi: enako kot predaje.
    match /podpisi/{id} {
      allow create: if prijavljen();
      allow read: if jeAdmin();
      allow update, delete: if false;
    }

    // Fotografije poškodb: vsak prijavljen jih lahko odda, branje samo skrbnik.
    match /fotke/{id} {
      allow create: if prijavljen();
      allow read: if jeAdmin();
      allow update, delete: if false;
    }

    // Arhiv odpravljenih napak: samo skrbnik.
    match /napake/{id} {
      allow read, create: if jeAdmin();
      allow update, delete: if false;
    }
  }
}
